[Nemo Action]
Name=Convert ODT to PDF
Comment=Convert selected ODT files to PDF
Exec=<~/scripts/odt2pdf.sh "$f">
Icon-Name=libreoffice-writer
Extensions=odt
Selection=notnone
EscapeSpaces=true
Dependencies=ocrmypdf;

[X-Nemo-Per-File]
# The Exec line calls the script and passes the selected file path ($f)

